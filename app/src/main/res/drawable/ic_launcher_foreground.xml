<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

  <!-- Five rounded waveform bars, tallest in the centre.
       Gradient runs from the Beam pink (#FF90E8) to the Beam yellow (#FFC700)
       so the launcher mark matches the in-app Beam zone. -->
  <path
      android:pathData="M28,46 L28,62 M41,37 L41,71 M54,29 L54,79 M67,37 L67,71 M80,46 L80,62"
      android:strokeWidth="7"
      android:strokeLineCap="round">
    <aapt:attr name="android:strokeColor">
      <gradient
          android:type="linear"
          android:startX="24"
          android:startY="79"
          android:endX="84"
          android:endY="29"
          android:startColor="#FFFF90E8"
          android:endColor="#FFFFC700" />
    </aapt:attr>
  </path>
</vector>
